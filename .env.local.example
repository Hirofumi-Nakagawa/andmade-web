MICROCMS_SERVICE_DOMAIN=
MICROCMS_API_KEY=

# Spotify "now playing" (header). One-time setup: fill in the first three,
# then visit http://127.0.0.1:3000/api/spotify/login while the dev server is
# running to get SPOTIFY_REFRESH_TOKEN.
# Note: Spotify requires an explicit loopback IP (127.0.0.1) here, not
# "localhost" — visit the site itself at 127.0.0.1:3000 too, not localhost:3000.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/spotify/callback
SPOTIFY_REFRESH_TOKEN=

# 404 page background (Google Static Maps API — see
# components/scenic-map-background.tsx). Requires a billing-enabled Google
# Cloud project with the "Maps Static API" enabled. NEXT_PUBLIC_ because a
# Static Maps key is meant to be used directly in an image URL from the
# client — restrict it by HTTP referrer (your own domain) in the Google
# Cloud Console rather than treating it as a server-side secret. Without
# this set, the 404 page simply renders with no background photo.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
