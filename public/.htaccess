# ANDMADE — さくらのレンタルサーバー用 Apache 設定
# ============================================================================
# next.config.ts の `output: "export"` で書き出した out/ をそのまま公開領域
# (/home/<アカウント>/www) に置いた前提。public/ 配下にあるので `next build`
# の出力に自動でコピーされる。
#
# ※ さくらの標準環境は Apache + mod_rewrite が有効。もし 500 エラーになる
#   場合は、その環境で無効なディレクティブ(Header / AddOutputFilterByType 等)
#   をコメントアウトして切り分けること。

# ===========================================================================
# 0. Basic認証（確認用サブドメイン専用）
# ===========================================================================
# ★★★ 本番公開（andmade.jp を実サイトに切り替える）時は、この 0. の
#     ブロックをまるごと削除して push すること。消し忘れると本番サイトが
#     ID/パスワードを要求する状態で公開される。
#
# 現在の運用: andmade.jp/preview/ （www/preview ディレクトリ）にデプロイし、
# andmade.jp 直下は手作業で上げた coming-soon ページのまま。
# この .htaccess は www/preview/ に置かれるので、認証も preview 配下だけに
# 効く（coming-soon には影響しない）。
#
# AuthUserFile は「公開領域(www)の外」の絶対パスを指定する。www の中に
# .htpasswd を置くと、URL を直接叩かれてハッシュを取得される可能性がある。
# <アカウント> は自分のさくらのアカウント名に書き換えること。
# .htpasswd の作り方は DEPLOY.md の「確認用ディレクトリの設定」を参照。
AuthType Basic
AuthName "ANDMADE preview"
AuthUserFile /home/<アカウント>/.htpasswd
Require valid-user

# ---------------------------------------------------------------------------
# 1. 拡張子なしURL → .html
# ---------------------------------------------------------------------------
# 静的書き出しでは /about は out/about.html というファイルになる。一方この
# サイトの正規URLは全てスラッシュ無し・拡張子無し(/about, /projects/xxx)なので、
# 実ファイルが無いリクエストに .html を補って解決する。
<IfModule mod_rewrite.c>
  RewriteEngine On

  # 既に存在するファイル/ディレクトリはそのまま(画像・JS・CSS・PHP など)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # /about → /about.html （対応する .html がある場合のみ）
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]

  # どれにも当たらなければ 404 ページ（Next が out/404.html を書き出す）。
  # 先頭スラッシュ無しの相対指定にしてあるのは、この .htaccess が置かれた
  # ディレクトリ基準で解決させるため。ルート公開でもサブディレクトリ公開でも
  # そのまま動く（/404.html と書くと preview 配下では本番ルートを見てしまう）。
  RewriteRule ^ 404.html [L]
</IfModule>

# ---------------------------------------------------------------------------
# 3. キャッシュ
# ---------------------------------------------------------------------------
# Next のビルド成果物(/_next/static/...)はファイル名にハッシュが入るので、
# 内容が変われば必ずURLも変わる = 長期キャッシュしても古いものが残らない。
# HTML はビルドのたびに同じURLで中身が変わるので、キャッシュさせない。
<IfModule mod_expires.c>
  ExpiresActive On

  # ハッシュ付きアセット: 1年
  <FilesMatch "\.(js|css|woff2|woff|ttf|otf)$">
    ExpiresDefault "access plus 1 year"
  </FilesMatch>

  # 画像・動画: 30日（public/ 配下の実ファイルはハッシュが付かないため控えめ）
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|avif|svg|ico|mp4|webm)$">
    ExpiresDefault "access plus 30 days"
  </FilesMatch>

  # HTML: 都度確認
  <FilesMatch "\.html$">
    ExpiresDefault "access plus 0 seconds"
  </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# ---------------------------------------------------------------------------
# 4. 圧縮
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ---------------------------------------------------------------------------
# 5. 文字コード
# ---------------------------------------------------------------------------
AddDefaultCharset UTF-8
AddType text/plain .txt
