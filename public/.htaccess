# ANDMADE — さくらのレンタルサーバー用 Apache 設定
# ============================================================================
# next.config.ts の `output: "export"` で書き出した out/ に、public/ 配下から
# 自動でコピーされる。アップロード先のディレクトリ直下に置かれる想定。
#
# ★ ここには「リライト」を書かない。
#   当初は /about → about.html の RewriteRule を置いていたが、さくらの共有
#   サーバーでは最後まで動かなかった:
#     - Next は about.html と about/ ディレクトリを同時に出力する
#     - Apache の mod_dir がリライトより先に「末尾スラッシュを付ける301」を
#       出すため、/about は結局 about/ への要求になり、index が無いので
#       403 Forbidden
#     - それを止める DirectorySlash / Options 系は AllowOverride で許可されて
#       おらず、書くと 500
#   next.config.ts を `trailingSlash: true` にして about/index.html を出す
#   構成に変えたことで、Apache 標準の DirectoryIndex がそのまま解決できる
#   ようになり、リライト自体が不要になった。
#
# ★ キャッシュ(ExpiresActive) / 圧縮(AddOutputFilterByType) /
#   Options / AddDefaultCharset は書かない。さくらの AllowOverride では
#   許可されていない可能性が高く、500 になる。足したい場合は1行ずつ追加して
#   都度確認すること（まとめて足すと原因の切り分けができない）。
#   ※ Header は下の「HTMLのキャッシュ制御」で1件だけ試験的に入れた —
#     デプロイ直後の動作確認を必ずすること（そこの★注記参照）。

# ---------------------------------------------------------------------------
# HTML のキャッシュ制御
# ---------------------------------------------------------------------------
# per direct follow-up ("（トップだけ）を取得すると旧 WordPress の HTML が
# 返ってきました これ返ってこないように修正したい")。サーバー自体は新サイト
# を返しており（キャッシュバスター付き URL では新サイトが返ることを確認
# 済み）、旧 HTML は経路上の共有キャッシュに残った古いコピー。HTML に
# Cache-Control が無いとキャッシュの保持期間はキャッシュ側の推測任せになり、
# この種の「いつまでも古い HTML が返る」事故が起きる。
#
# no-cache = 「保存してもよいが、使う前に毎回サーバーへ再検証せよ」。
# Apache は ETag/Last-Modified を自動で付けるので、変更が無ければ 304 で
# 済み、変更があれば即座に新しい HTML が行き渡る。デプロイ反映の即時性も
# これで上がる（CMS 更新→Run workflow 後の反映待ちにも効く）。
# HTML だけに掛けるのは、/_next/static/ 配下はファイル名にハッシュが入って
# いて内容が変わればURLも変わる＝古いキャッシュが害にならないため（そちらは
# むしろ長期キャッシュが正しいが、ディレクティブは1つずつ足す方針なので
# 今回は見送り）。
#
# ★ 上の注意書きどおり Header 系は さくらの AllowOverride で拒否され 500 に
#   なる可能性がある。デプロイ直後に必ずトップが開くことを確認し、500 なら
#   このブロックごと削除して再デプロイすること。<IfModule> は
#   「mod_headers が無い場合に無視する」保険で、AllowOverride 拒否には
#   効かない（その場合は 500 になる）。
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# ---------------------------------------------------------------------------
# 404ページ
# ---------------------------------------------------------------------------
# __BASE_PATH__ は scripts/verify-build.mjs がビルド時に実際の basePath へ
# 置換する（確認用 /preview 公開なら "/preview"、本番なら空文字）。
# ErrorDocument は相対パスを受け付けない（スラッシュで始まらない値は
# 「そのまま表示する文字列」と解釈される）ため、公開先ごとに絶対パスを
# 埋める必要がある。手で書き換えると本番移行時に忘れるのでビルドに任せる。
ErrorDocument 404 __BASE_PATH__/404.html

# ---------------------------------------------------------------------------
# Basic認証（確認用 /preview 公開のときだけ有効にする）
# ---------------------------------------------------------------------------
# ★ 本番公開に切り替えたため、まるごと無効化してある（2026-08 公開時）。
#   有効なままだと本番サイトが ID/パスワードを要求する状態で公開される。
#   DEPLOY.md の「本番公開に切り替えるとき」も参照。
#
# もう一度 /preview で確認用に公開したくなったら、下の2ブロックの
# コメントを外す（AuthType〜Require の4行と、<Files> ブロックは必ずセットで。
# 認証だけ復活させると now-playing.php まで認証対象になり、ローカル開発の
# Spotify 表示が止まる）。
#
# AuthUserFile は公開領域(www)の外を指すこと。www の中に .htpasswd を置くと
# URL 直打ちでハッシュを取得される可能性がある。
# このファイルが無い/読めない状態で AuthUserFile を書くと、サイト全体が 500
# になるので、無効化するときは4行まとめてコメントアウトする。
#
#   確認: ssh andmade@andmade.sakura.ne.jp 'ls -la ~/.htpasswd'
#   作成: 手元のMacで  htpasswd -c ~/Desktop/htpasswd.txt preview
#
# AuthType Basic
# AuthName "ANDMADE preview"
# AuthUserFile /home/andmade/.htpasswd
# Require valid-user

# now-playing.php だけ認証の対象外にする — per direct follow-up
# ("localhost:3000でspotifyが確認できなくなってるのはなぜ？" への対処)。
# ローカル開発時（Next の dev サーバーは PHP を実行できない）に
# components/now-playing-provider.tsx がこのURLを直接叩くため。
# 返るのは再生中の曲名だけで、認証情報も CMS の内容も含まない。
# 認証を掛けていない今は不要なので、上とセットで無効化してある。
# ※ Satisfy Any + Allow from all の組み合わせは Apache 2.2 系の書き方だが、
#   さくらの環境では 2.4 でも mod_access_compat 経由で有効。
#   もしここで 500 になるようなら、このブロックを消して
#   now-playing-provider.tsx 側の開発用URLも戻すこと。
#
# <Files "now-playing.php">
#   Satisfy Any
#   Order Allow,Deny
#   Allow from all
# </Files>
